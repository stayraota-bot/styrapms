# ---------------------------------------------------------------------------
# STAYRA PMS environment variables. Copy to .env.local for development.
# On Vercel: Project → Settings → Environment Variables (set Production and
# Preview/Development separately, pointing at DIFFERENT Supabase projects).
# ---------------------------------------------------------------------------

# "supabase" in every deployed environment. "local" = offline dev/CI only
# (uses a local Postgres + built-in password check; refused on Vercel production).
AUTH_MODE=supabase

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://app.stayra.in

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase → Connect → Transaction pooler (port 6543). Region: ap-south-1 (Mumbai).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used only by `npm run db:migrate`
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Random 32+ char string. Signs local-mode sessions and protects the cron endpoint.
AUTH_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# Set to "true" ONLY on a dedicated demo/staging Supabase project.
ALLOW_DEMO_SEED=false
